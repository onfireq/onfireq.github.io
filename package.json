{
  "name": "portfolio-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "worker:types": "wrangler types workers/zhihu-sync/worker-configuration.d.ts --include-runtime false",
    "worker:typecheck": "tsc -p workers/zhihu-sync/tsconfig.json",
    "worker:test:typecheck": "tsc -p workers/zhihu-sync/test/tsconfig.json",
    "worker:test": "npm run worker:test:typecheck && vitest run --config workers/zhihu-sync/vitest.config.mts",
    "worker:check": "npm run worker:types && npm run worker:typecheck && wrangler deploy --dry-run",
    "worker:startup": "wrangler check startup",
    "worker:dev": "wrangler dev",
    "snapshot:check": "python sync_zhihu.py --check",
    "snapshot:test": "python workers/zhihu-sync/test/test_sync_zhihu.py",
    "check": "npm run lint && npm run typecheck && npm run snapshot:check && npm run snapshot:test && npm run worker:check && npm run worker:test:typecheck && npm run build",
    "check:ci": "npm run check && npm run worker:test",
    "elog:sync": "elog sync -e .elog.env",
    "blog:publish": "npm run elog:sync && git add content/blog && git commit -m '📝 同步 wolai 博客' && git push"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "framer-motion": "^12.42.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.1",
    "next": "^16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "three": "^0.185.1",
    "unified": "^11.0.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@elog/cli": "^1.0.0-beta.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
